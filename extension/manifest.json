{
  "manifest_version": 3,
  "name": "YouTube Skip",
  "version": "1.3.2",
  "description": "Click (or Alt+S) to play the video at 16x for a few seconds. On YouTube it can sense ads and speed through them.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "ads.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icon200b.png",
    "48": "icon200.png",
    "128": "icon200.png"
  },
  "action": {
    "default_title": "YouTube Skip: 16x for a few seconds (Alt+S)",
    "default_icon": {
      "16": "icon200b.png",
      "32": "icon200b.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Play the video at 16x for a few seconds"
    }
  }
}
